  "terms": [
    {
      "id": "T-TR-IV",
      "term": "implied volatility",
      "meaning": {
        "en": "The volatility input inferred from an option price using a pricing model.",
        "hi": "Option की कीमत से model के ज़रिये निकाला गया उतार-चढ़ाव का अनुमान।"
      },
      "say": {
        "hi": "इम्प्लाइड वोलैटिलिटी"
      }
    },
    {
      "id": "T-TR-CRUSH",
      "term": "IV crush",
      "meaning": {
        "en": "A sharp fall in implied volatility; the illustrative case shows one after an event.",
        "hi": "इस case में announcement के बाद implied volatility का तेज़ गिरना।"
      },
      "say": {
        "hi": "आई वी क्रश"
      }
    },
    {
      "id": "T-TR-PREMIUM",
      "term": "premium",
      "meaning": {
        "en": "The price of an option, quoted per unit in this case.",
        "hi": "इस case में option की प्रति unit कीमत।"
      },
      "say": {
        "hi": "प्रीमियम"
      }
    },
    {
      "id": "T-TR-STRADDLE",
      "term": "straddle",
      "meaning": {
        "en": "A call and a put at the same strike and expiry.",
        "hi": "एक ही strike और expiry का call और put।"
      },
      "say": {
        "hi": "स्ट्रैडल"
      }
    },
    {
      "id": "T-TR-MOVE",
      "term": "implied move",
      "meaning": {
        "en": "The desk estimate of a priced move, using the ATM straddle as a rough guide.",
        "hi": "Desk का अनुमान कि option की कीमत में कितना move शामिल है।"
      },
      "say": {
        "hi": "इम्प्लाइड मूव"
      }
    },
    {
      "id": "T-TR-THETA",
      "term": "theta",
      "meaning": {
        "en": "The model sensitivity to one day passing, holding other pricing inputs fixed.",
        "hi": "बाकी model inputs स्थिर रखकर एक दिन बीतने से कीमत की संवेदनशीलता।"
      },
      "say": {
        "hi": "थीटा"
      }
    },
    {
      "id": "T-TR-TIME",
      "term": "time value",
      "meaning": {
        "en": "The part of an option price above its intrinsic value.",
        "hi": "Option की कीमत का intrinsic value से ऊपर वाला हिस्सा।"
      },
      "say": {
        "hi": "टाइम वैल्यू"
      }
    },
    {
      "id": "T-TR-BUDGET",
      "term": "event budget",
      "meaning": {
        "en": "The illustrative desk limit on maximum loss per event trade.",
        "hi": "इस desk की एक event trade में स्वीकार्य अधिकतम नुकसान की सीमा।"
      },
      "say": {
        "hi": "इवेंट बजट"
      }
    },
    {
      "id": "T-TR-LOSS",
      "term": "max loss",
      "meaning": {
        "en": "The worst loss specified for the position under the stated assumptions.",
        "hi": "बताई गई assumptions में position का सबसे बड़ा नुकसान।"
      },
      "say": {
        "hi": "मैक्स लॉस"
      }
    },
    {
      "id": "T-TR-DEFINED",
      "term": "defined risk",
      "meaning": {
        "en": "A structure whose maximum loss is bounded under the stated contract assumptions.",
        "hi": "ऐसी structure जिसका अधिकतम नुकसान बताई गई शर्तों में सीमित हो।"
      },
      "say": {
        "hi": "डिफाइन्ड रिस्क"
      }
    },
    {
      "id": "T-TR-NOTE",
      "term": "pre-trade note",
      "meaning": {
        "en": "The written decision record made before a paper order.",
        "hi": "Paper order से पहले लिखा हुआ decision record।"
      },
      "say": {
        "hi": "प्री ट्रेड नोट"
      }
    },
    {
      "id": "T-TR-BIAS",
      "term": "outcome bias",
      "meaning": {
        "en": "Judging a decision by its result instead of the information and process available beforehand.",
        "hi": "पहले की जानकारी और process के बजाय नतीजे से decision को आँकना।"
      },
      "say": {
        "hi": "आउटकम बायस"
      }
    }
  ],
