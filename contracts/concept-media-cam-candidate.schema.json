      "title": "Catalogversion",
      "type": "string"
    },
    "mediaRevision": {
      "pattern": "^cm-[a-f0-9]{24}$",
      "title": "Mediarevision",
      "type": "string"
    },
    "release": {
      "enum": [
        "sample_unreviewed",
        "reviewed"
      ],
      "title": "Release",
      "type": "string"
    },
    "narration": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/NarrationRendition"
          },
          {
            "$ref": "#/$defs/ConceptNarrationRendition"
          }
        ]
      },
      "title": "Narration",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "discriminator": {
          "mapping": {
            "cam-concept-canvas/v1": "#/$defs/ConceptCanvasArtifact",
            "coherent-phase-recovery/v1": "#/$defs/PhaseRecoveryScene"
          },
          "propertyName": "renderer"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ConceptCanvasArtifact"
          },
          {
            "$ref": "#/$defs/PhaseRecoveryScene"
          }
        ]
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "planId",
    "conceptId",
    "catalogVersion",
    "mediaRevision",
    "release",
    "narration",
    "artifacts"
  ],
  "title": "CandidateMediaManifest",
  "type": "object"
}
