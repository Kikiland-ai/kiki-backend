    "conceptId": {
      "pattern": "^C-AM-(0[1-9]|10)$",
      "title": "Conceptid",
      "type": "string"
    },
    "catalogVersion": {
      "pattern": "^am-[a-f0-9]{24}$",
      "title": "Catalogversion",
      "type": "string"
    },
    "mediaRevision": {
      "pattern": "^cm-[a-f0-9]{24}$",
