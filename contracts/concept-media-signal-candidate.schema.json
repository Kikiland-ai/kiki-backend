          "type": "string"
        },
        "alignment": {
          "const": "not_performed",
          "title": "Alignment",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "alignment"
      ],
      "title": "ClipTiming",
      "type": "object"
    },
