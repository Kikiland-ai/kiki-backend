{
  "$defs": {
    "BehaviorTest": {
      "additionalProperties": false,
      "description": "A renderer must reproduce these values before it may draw the scene.",
      "properties": {
        "inputs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Inputs",
          "type": "object"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "inputs",
        "output",
        "expected",
        "tolerance"
      ],
      "title": "BehaviorTest",
      "type": "object"
    },
    "ClipTiming": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clip_duration_only",
