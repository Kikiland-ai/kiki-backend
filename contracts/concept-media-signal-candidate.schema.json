          "type": "string"
        },
        "renditionId": {
          "pattern": "^C-AM-(0[1-9]|10)\\.concept\\.(en|or)$",
          "title": "Renditionid",
          "type": "string"
        },
        "placardIds": {
          "items": {
            "type": "string"
