      "required": [
        "lang",
        "assetId",
        "mimeType",
        "bytes",
        "durationSeconds",
        "sourceTextSha256",
        "speechScriptSha256",
        "audioSha256",
        "narrationKind",
        "speech",
        "timing",
        "review",
        "scope",
        "conceptId",
        "renditionId",
        "placardIds"
