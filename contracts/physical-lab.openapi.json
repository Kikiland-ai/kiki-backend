{
  "components": {
    "schemas": {
      "CreatePreparation": {
        "additionalProperties": false,
        "properties": {
          "experiment_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Experiment Id",
            "type": "string"
          },
          "language": {
            "default": "or",
            "enum": [
              "en",
              "or"
            ],
            "title": "Language",
            "type": "string"
          },
          "mode": {
            "default": "guided_preparation",
            "enum": [
              "guided_preparation",
              "experiment_demo"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "experiment_id"
        ],
        "title": "CreatePreparation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PreparationEvent": {
        "additionalProperties": false,
        "properties": {
          "answers": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 30,
            "title": "Answers",
            "type": "object"
          },
          "event_id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Event Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "select",
              "advance",
              "answer",
              "connect",
              "set",
              "measure",
              "language"
            ],
            "title": "Kind",
            "type": "string"
          },
          "other": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Other"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "target": {
            "default": "",
            "maxLength": 100,
            "title": "Target",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "event_id",
          "revision",
          "kind"
        ],
        "title": "PreparationEvent",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
