{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiki:screen-writing:v0.2",
  "title": "Screen writing producer/consumer protocol v0.2",
  "description": "Breaking v0.2 protocol: cue request, resolved full replacement, ordered cancellation and delivery acknowledgement. Runtime trust/ordering rules are mandatory.",
  "oneOf": [
    {
      "$ref": "#/$defs/cue_request"
    },
    {
      "$ref": "#/$defs/resolved_packet"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/delivery_ack"
    }
  ],
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lab_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "experiment_id": {
          "const": "PR-AM-DSB"
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^CP-DSB-(0[1-9]|1[0-2])$"
        },
        "visit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lab_revision": {
          "type": "integer",
          "minimum": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "capture_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "parameter_revision": {
          "type": "integer",
          "minimum": 0
        },
        "view_revision": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "enum": [
            "baseline",
            "phase_fault",
            "restored_baseline"
          ]
        }
      },
      "required": [
        "lab_session_id",
        "experiment_id",
        "checkpoint_id",
        "visit_id",
        "lab_revision",
        "workspace_id",
        "capture_epoch",
        "parameter_revision",
        "view_revision",
        "condition"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "encoded_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        },
        "encoded_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        },
        "capture_elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "capture_time_authority": {
          "const": "capture_client_monotonic"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_time_authority": {
          "const": "observer_server_utc"
        },
        "view_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "observation_id",
        "frame_id",
        "sha256",
        "byte_count",
        "encoded_width",
        "encoded_height",
        "capture_elapsed_ms",
        "capture_time_authority",
        "received_at",
        "admitted_at",
        "receipt_time_authority",
        "view_revision"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "media_type": {
          "const": "image/jpeg"
        },
        "access_policy": {
          "const": "same_owner_ephemeral"
        }
      },
      "required": [
        "handle_id",
        "expires_at",
        "media_type",
        "access_policy"
      ]
    },
    "requested_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "enum": [
            "workspace.canvas",
            "workspace.model_title",
            "message.block",
            "carrier.block",
            "message.frequency",
            "carrier.frequency",
            "local_carrier.phase",
            "local_carrier.frequency",
            "modulator.message_input",
            "receiver.modulated_input",
            "lowpass.numerator",
            "lowpass.denominator",
            "recovery_gain.value",
            "simulation.stop_time",
            "simulation.solver",
            "simulation.max_step",
            "simulation.run_control",
            "recovery_scope.original_trace",
            "recovery_scope.recovered_trace",
            "model.save_control"
          ]
        },
        "semantic_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "workspace",
            "readout",
            "block",
            "parameter_field",
            "port",
            "trace",
            "control"
          ]
        },
        "block_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "parameter_name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "criterion_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required_for_cue": {
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "semantic_label",
        "kind",
        "block_id",
        "parameter_name",
        "criterion_ids",
        "required_for_cue"
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "connects_to",
            "compares_with",
            "influences"
          ]
        },
        "from_target_id": {
          "enum": [
            "workspace.canvas",
            "workspace.model_title",
            "message.block",
            "carrier.block",
            "message.frequency",
            "carrier.frequency",
            "local_carrier.phase",
            "local_carrier.frequency",
            "modulator.message_input",
            "receiver.modulated_input",
            "lowpass.numerator",
            "lowpass.denominator",
            "recovery_gain.value",
            "simulation.stop_time",
            "simulation.solver",
            "simulation.max_step",
            "simulation.run_control",
            "recovery_scope.original_trace",
            "recovery_scope.recovered_trace",
            "model.save_control"
          ]
        },
        "to_target_id": {
          "enum": [
            "workspace.canvas",
            "workspace.model_title",
            "message.block",
            "carrier.block",
            "message.frequency",
            "carrier.frequency",
            "local_carrier.phase",
            "local_carrier.frequency",
            "modulator.message_input",
            "receiver.modulated_input",
            "lowpass.numerator",
            "lowpass.denominator",
            "recovery_gain.value",
            "simulation.stop_time",
            "simulation.solver",
            "simulation.max_step",
            "simulation.run_control",
            "recovery_scope.original_trace",
            "recovery_scope.recovered_trace",
            "model.save_control"
          ]
        }
      },
      "required": [
        "relationship_id",
        "kind",
        "from_target_id",
        "to_target_id"
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "enum": [
            "workspace.canvas",
            "workspace.model_title",
            "message.block",
            "carrier.block",
            "message.frequency",
            "carrier.frequency",
            "local_carrier.phase",
            "local_carrier.frequency",
            "modulator.message_input",
            "receiver.modulated_input",
            "lowpass.numerator",
            "lowpass.denominator",
            "recovery_gain.value",
            "simulation.stop_time",
            "simulation.solver",
            "simulation.max_step",
            "simulation.run_control",
            "recovery_scope.original_trace",
            "recovery_scope.recovered_trace",
            "model.save_control"
          ]
        },
        "u": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "v": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "target_id",
        "u",
        "v"
      ]
    },
    "resolved_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "enum": [
            "workspace.canvas",
            "workspace.model_title",
            "message.block",
            "carrier.block",
            "message.frequency",
            "carrier.frequency",
            "local_carrier.phase",
            "local_carrier.frequency",
            "modulator.message_input",
            "receiver.modulated_input",
            "lowpass.numerator",
            "lowpass.denominator",
            "recovery_gain.value",
            "simulation.stop_time",
            "simulation.solver",
            "simulation.max_step",
            "simulation.run_control",
            "recovery_scope.original_trace",
            "recovery_scope.recovered_trace",
            "model.save_control"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous"
          ]
        },
        "method": {
          "oneOf": [
            {
              "enum": [
                "model_vision",
                "ocr",
                "semantic_dom",
                "simulink_adapter",
                "human_review"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "oneOf": [
            {
              "$ref": "#/$defs/region"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "target_id",
        "status",
        "method",
        "region",
        "reason"
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_frame_age_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        }
      },
      "required": [
        "created_at",
        "expires_at",
        "max_frame_age_ms"
      ]
    },
    "cue_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "screen-writing/v0.2"
        },
        "message_type": {
          "const": "cue_request"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "guidance_stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cue_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "intent": {
          "enum": [
            "show_action_target",
            "explain_relationship",
            "highlight_parameter",
            "compare_waveforms"
          ]
        },
        "canonical_instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "canonical_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "frame_handle": {
          "$ref": "#/$defs/handle"
        },
        "requested_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/requested_target"
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "requested_surface": {
          "enum": [
            "captured_frame",
            "live_workspace"
          ]
        },
        "replacement": {
          "const": "replace_complete_guidance_layer"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        }
      },
      "required": [
        "schema",
        "message_type",
        "request_id",
        "guidance_stream_id",
        "cue_sequence",
        "context",
        "intent",
        "canonical_instruction",
        "canonical_reason",
        "frame",
        "frame_handle",
        "requested_targets",
        "relationships",
        "requested_surface",
        "replacement",
        "validity"
      ]
    },
    "resolved_packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "screen-writing/v0.2"
        },
        "message_type": {
          "const": "resolved_packet"
        },
        "packet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "guidance_stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cue_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "resolved_targets": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/resolved_target"
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "operations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "pointer"
                  },
                  "cue_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "meaning": {
                    "enum": [
                      "concept",
                      "words",
                      "english",
                      "lab"
                    ]
                  },
                  "accessible_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "anchor": {
                    "$ref": "#/$defs/anchor"
                  }
                },
                "required": [
                  "kind",
                  "cue_id",
                  "meaning",
                  "accessible_label",
                  "anchor"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "box"
                  },
                  "cue_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "meaning": {
                    "enum": [
                      "concept",
                      "words",
                      "english",
                      "lab"
                    ]
                  },
                  "accessible_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "target_id": {
                    "enum": [
                      "workspace.canvas",
                      "workspace.model_title",
                      "message.block",
                      "carrier.block",
                      "message.frequency",
                      "carrier.frequency",
                      "local_carrier.phase",
                      "local_carrier.frequency",
                      "modulator.message_input",
                      "receiver.modulated_input",
                      "lowpass.numerator",
                      "lowpass.denominator",
                      "recovery_gain.value",
                      "simulation.stop_time",
                      "simulation.solver",
                      "simulation.max_step",
                      "simulation.run_control",
                      "recovery_scope.original_trace",
                      "recovery_scope.recovered_trace",
                      "model.save_control"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "cue_id",
                  "meaning",
                  "accessible_label",
                  "target_id"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "ellipse"
                  },
                  "cue_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "meaning": {
                    "enum": [
                      "concept",
                      "words",
                      "english",
                      "lab"
                    ]
                  },
                  "accessible_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "target_id": {
                    "enum": [
                      "workspace.canvas",
                      "workspace.model_title",
                      "message.block",
                      "carrier.block",
                      "message.frequency",
                      "carrier.frequency",
                      "local_carrier.phase",
                      "local_carrier.frequency",
                      "modulator.message_input",
                      "receiver.modulated_input",
                      "lowpass.numerator",
                      "lowpass.denominator",
                      "recovery_gain.value",
                      "simulation.stop_time",
                      "simulation.solver",
                      "simulation.max_step",
                      "simulation.run_control",
                      "recovery_scope.original_trace",
                      "recovery_scope.recovered_trace",
                      "model.save_control"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "cue_id",
                  "meaning",
                  "accessible_label",
                  "target_id"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "arrow"
                  },
                  "cue_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "meaning": {
                    "enum": [
                      "concept",
                      "words",
                      "english",
                      "lab"
                    ]
                  },
                  "accessible_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "relationship_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "from": {
                    "$ref": "#/$defs/anchor"
                  },
                  "to": {
                    "$ref": "#/$defs/anchor"
                  }
                },
                "required": [
                  "kind",
                  "cue_id",
                  "meaning",
                  "accessible_label",
                  "relationship_id",
                  "from",
                  "to"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "polyline"
                  },
                  "cue_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "meaning": {
                    "enum": [
                      "concept",
                      "words",
                      "english",
                      "lab"
                    ]
                  },
                  "accessible_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "relationship_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "anchors": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 128,
                    "items": {
                      "$ref": "#/$defs/anchor"
                    }
                  },
                  "reveal_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000
                  }
                },
                "required": [
                  "kind",
                  "cue_id",
                  "meaning",
                  "accessible_label",
                  "relationship_id",
                  "anchors",
                  "reveal_ms"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "cue_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "meaning": {
                    "enum": [
                      "concept",
                      "words",
                      "english",
                      "lab"
                    ]
                  },
                  "accessible_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "anchor": {
                    "$ref": "#/$defs/anchor"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "kind",
                  "cue_id",
                  "meaning",
                  "accessible_label",
                  "anchor",
                  "text"
                ]
              }
            ]
          }
        },
        "replacement": {
          "const": "replace_complete_guidance_layer"
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "enum": [
                "captured_frame",
                "live_workspace"
              ]
            },
            "coordinate_space": {
              "const": "normalized_encoded_frame"
            },
            "adapter_binding_id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "transform_revision": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "pointer_events": {
              "const": "none"
            },
            "clip_to_frame": {
              "const": true
            }
          },
          "required": [
            "surface",
            "coordinate_space",
            "adapter_binding_id",
            "transform_revision",
            "pointer_events",
            "clip_to_frame"
          ]
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "reason": {
              "enum": [
                "none",
                "unresolved_required_target"
              ]
            }
          },
          "required": [
            "instruction",
            "reason"
          ]
        }
      },
      "required": [
