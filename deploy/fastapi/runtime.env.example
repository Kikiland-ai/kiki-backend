# Documentation template only; the process does not automatically load .env files.
# Set real values through the chosen Python host's server-side secret settings.
GEMINI_API_KEY=
# Optional rotating screen pool; omit entirely if using the single-key fallback.
# GEMINI_API_KEYS=["REPLACE_WITH_KEY_1","REPLACE_WITH_KEY_2"]
GEMINI_LAB_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_SPEECH_MODEL=gemini-3.8-flash-lite-tts
GEMINI_SPEECH_VOICE=Kore
KIKI_REQUIRE_PROXY=1
KIKI_PROXY_SECRET=
KIKI_DATA_DIR=/var/data/kiki
PORT=10000
# Separately on the Site: KIKI_FASTAPI_ORIGIN=<verified HTTPS root>
# and the same KIKI_PROXY_SECRET. Replace the prepared edge helper before activation.
