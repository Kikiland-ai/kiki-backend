{
  "artifactId": "SCENE-AM-01-signal-parameters",
  "renderer": "signal-parameters/v1",
  "placardIds": [
    "CARD-AM-01-concept",
    "CARD-AM-01-application"
  ],
  "prompt": "Change frequency and observe period and angular frequency.",
  "altText": "Amplitude, frequency and phase; Peak size: amplitude. Cycles per second: frequency. Relative timing: phase. Convert Hz using 2*pi*f.",
  "controls": [
    {
      "name": "amplitude",
      "label": "Amplitude",
      "unit": "normalized",
      "min": 0.25,
      "max": 2.0,
      "step": 0.25,
      "default": 1.0
    },
    {
      "name": "frequency",
      "label": "Frequency",
      "unit": "Hz",
      "min": 10.0,
      "max": 1000.0,
      "step": 10.0,
      "default": 100.0
    },
    {
      "name": "phase",
      "label": "Phase",
      "unit": "degree",
      "min": 0.0,
      "max": 180.0,
      "step": 15.0,
      "default": 0.0
    }
  ],
  "outputs": [
    {
      "name": "periodSeconds",
      "label": "Period",
      "unit": "s"
    },
    {
      "name": "angularFrequency",
      "label": "Angular frequency",
      "unit": "rad/s"
    }
  ],
  "timeWindowSeconds": 0.02,
  "sampleIntervals": 900,
  "reference": "unit_amplitude_zero_phase_same_frequency",
  "amplitudeUnit": "normalized",
  "claim": "ideal_teaching_model",
  "sources": [
    {
      "origin": "curated",
      "label": "MathWorks: analog passband modulation; reference for the modulation families",
      "url": "https://www.mathworks.com/help/comm/ug/analog-passband-modulation.html"
    }
  ],
  "bindings": [
