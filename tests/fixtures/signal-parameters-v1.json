  "behaviorTests": [
    {
      "inputs": {
        "amplitude": 1.0,
        "frequency": 100.0,
        "phase": 0.0
      },
      "output": "periodSeconds",
      "expected": 0.01,
      "tolerance": 1e-08
    },
    {
      "inputs": {
        "amplitude": 1.0,
        "frequency": 100.0,
        "phase": 0.0
      },
      "output": "angularFrequency",
      "expected": 628.318530717959,
      "tolerance": 1e-08
    },
    {
      "inputs": {
        "amplitude": 1.0,
        "frequency": 10.0,
        "phase": 0.0
      },
      "output": "periodSeconds",
      "expected": 0.1,
